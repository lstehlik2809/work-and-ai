{
  "name": "work-and-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "validate:data": "node scripts/data/validate.mjs",
    "validate:semantic": "node scripts/semantic/validate.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "data:fetch": "node scripts/data/fetch.mjs",
    "data:prepare": "python scripts/data/prepare.py",
    "semantic:build": "node scripts/semantic/build.mjs",
    "evaluate": "tsx scripts/evaluate.ts",
    "browser:check": "node scripts/browser-check.mjs",
    "skills:prepare": "node scripts/data/skills.mjs",
    "skills:fetch": "node scripts/data/skills.mjs --fetch",
    "validate:skills": "node scripts/data/skills.mjs --check",
    "browser:skills": "node scripts/skills-browser-check.mjs",
    "ai-context:extract": "python scripts/data/extract-ai-context.py",
    "ai-context:prepare": "node scripts/data/ai-context.mjs",
    "ai-context:fetch": "node scripts/data/ai-context.mjs --fetch",
    "validate:ai-context": "node scripts/data/ai-context.mjs --check",
    "browser:ai-context": "node scripts/ai-context-browser-check.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "fuse.js": "7.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "1.62.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.2.2"
  },
  "overrides": {
    "onnxruntime-web": "1.29.0",
    "sharp": "0.35.4",
    "adm-zip": "0.6.0"
  }
}
